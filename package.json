{
  "name": "tunnely",
  "productName": "Tunnely VPN",
  "version": "1.0.6",
  "description": "Tunnely VPN — клиент для подключения к VPN",
  "author": "Tunnely",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build-core": "node scripts/build-core.mjs",
    "fetch-core": "node scripts/fetch-core.mjs",
    "fetch-xray": "node scripts/fetch-xray.mjs",
    "build-helper": "node scripts/build-helper.mjs",
    "icons": "node scripts/make-icons.mjs",
    "prepare-resources": "npm run build-core && npm run fetch-xray && npm run build-helper && npm run icons",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"tests/*.test.ts\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run prepare-resources && npm run typecheck && electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "js-yaml": "5.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "flag-icons": "7.6.0",
    "playwright-core": "^1.64.1",
    "png-to-ico": "3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
